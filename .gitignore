*.o
*.obj
*.exe
*.out
*.dll
*.so
*.dylib
*.a
*.lib

# Python caches and virtual environments
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
.env/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Build outputs
build/
bin/
*.log
paper/build/*.aux
paper/build/*.log
paper/build/*.out
paper/build/*.pdf
paper/build/*.tex

# The reports/ directory is NOT ignored: it holds the machine-readable result
# artifacts (benchmark.json, sensitivity.json, key_schedule_sac.json, ...) that
# back every empirical claim in the manuscript and are required for independent
# reproduction. Only transient scratch files are excluded below.
reports/*.tmp
